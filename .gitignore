# Runtime state — never commit a trading ledger
data/
# Books left behind by a schema change. The post-audit state format is not
# readable by the old loader and vice versa, so an incompatible book is moved
# aside rather than deleted; it is still runtime state and still must not be
# committed.
data-v*/
.env

# Documented run output: the book, the decisions and the verbatim prompts of a
# live session. Same reasoning as data/ — generated, not source, and the
# console logs carry the internal gateway hostname.
runs/
.lastrun

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
