# Runtime state — never commit a trading ledger.
# Anchored with a leading slash: an unanchored `data/` matches a directory of
# that name at *any* depth, so it silently swallowed `src/memetrader/data/`.
# Only the repository-root runtime directory was ever meant to be ignored.
/data/
# Books left behind by a schema change. The post-audit state format is not
# readable by the old loader and vice versa, so an incompatible book is moved
# aside rather than deleted; it is still runtime state and still must not be
# committed.
data-v*/
.env

# Documented run output: the book, the decisions and the verbatim prompts of a
# live session. Same reasoning as data/ — generated, not source, and the
# console logs carry the internal gateway hostname.
runs/
.lastrun

# Backfilled OHLCV. Large (~1.7M rows) and fully regenerable from
# universe/solana_memecoins.toml, which *is* committed because it is the
# definition of the experiment rather than its output. The manifest lives in
# here too, so provenance travels with the data it describes.
history/

# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
